{
  "name": "QuantifyApp",
  "main": "index.ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "devtools": "react-devtools",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"__tests__/**/*.{ts,tsx}\" \"*.{js,json,md}\"",
    "clean": "bash scripts/clean.sh",
    "postinstall": "node scripts/patch-skia-path-deprecations.js",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.28.0",
    "@op-engineering/op-sqlite": "^15.1.6",
    "@opptrix/fuyao": "^1.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.8",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@wuba/react-native-echarts": "^3.1.1",
    "base-64": "^1.0.0",
    "echarts": "^6.1.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fund-api": "^1.2.1",
    "iconv-lite": "^0.7.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-graph": "^1.4.0",
    "react-native-haptic-feedback": "^2.3.4",
    "react-native-kline-chart": "^0.1.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "stock-api": "^2.7.3",
    "stock-sdk": "file:./stock-sdk",
    "zrender": "^6.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.0",
    "@babel/runtime": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "3.9.6",
    "react-devtools": "^6.1.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "react-native-vector-icons"
        ],
        "listUnknownPackages": false
      }
    }
  }
}

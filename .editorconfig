# EditorConfig — 统一编辑器缩进/换行，与 Prettier 对齐
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.java]
indent_size = 4

[*.kt]
indent_size = 4

[Makefile]
indent_style = tab
